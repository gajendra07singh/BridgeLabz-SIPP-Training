CLASS Job
    ATTRIBUTE id
    ATTRIBUTE deadline
    ATTRIBUTE processingTime

    CONSTRUCTOR(id, deadline, processingTime)
        this.id = id
        this.deadline = deadline
        this.processingTime = processingTime
    END CONSTRUCTOR
END CLASS


CLASS JobScheduler
    ATTRIBUTE priorityQueue   // Min-Heap or Sorted List

    METHOD addJob(job)
        INSERT job INTO priorityQueue ORDERED BY (deadline, processingTime)
    END METHOD

    METHOD scheduleJobs()
        PRINT "Scheduling Jobs in Priority Order:"
        WHILE priorityQueue is NOT EMPTY
            job = REMOVE_MIN(priorityQueue)   // pick job with earliest deadline
            PRINT "Running Job ", job.id, 
                  " | Deadline: ", job.deadline, 
                  " | Processing Time: ", job.processingTime
            WAIT job.processingTime units
            PRINT "Job ", job.id, " completed."
        END WHILE
    END METHOD
END CLASS


MAIN
    scheduler = NEW JobScheduler()

    job1 = NEW Job("A", 5, 3)
    job2 = NEW Job("B", 2, 1)
    job3 = NEW Job("C", 2, 2)
    job4 = NEW Job("D", 7, 4)

    scheduler.addJob(job1)
    scheduler.addJob(job2)
    scheduler.addJob(job3)
    scheduler.addJob(job4)

    scheduler.scheduleJobs()
END MAIN
