CLASS QuizTimer
    ATTRIBUTE timeSlots[]   // circular array
    ATTRIBUTE size
    ATTRIBUTE front
    ATTRIBUTE rear

    CONSTRUCTOR(timePerQuestion[], n)
        size = n
        timeSlots = new array of size n
        FOR i = 0 TO n-1
            timeSlots[i] = timePerQuestion[i]
        END FOR
        front = 0
        rear = n-1
    END CONSTRUCTOR


    METHOD startQuiz()
        question = 1
        index = front

        LOOP question <= size
            timeLeft = timeSlots[index]

            PRINT "Question ", question, " started. Time = ", timeLeft, " sec"

            WHILE timeLeft > 0
                WAIT 1 second
                timeLeft = timeLeft - 1

                IF timeLeft == 5 THEN
                    PRINT " Warning: Only 5 seconds left for Question ", question
                END IF
            END WHILE

            PRINT " Time over for Question ", question

            // move circularly
            index = (index + 1) MOD size
            question = question + 1
        END LOOP
    END METHOD
END CLASS


MAIN
    times = [30, 45, 60]   // seconds for each question
    quiz = NEW QuizTimer(times, 3)
    quiz.startQuiz()
END MAIN
