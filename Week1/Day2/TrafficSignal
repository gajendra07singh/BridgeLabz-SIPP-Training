ENUM TrafficLight
    RED
    YELLOW
    GREEN
END ENUM


CLASS TrafficSignal
    ATTRIBUTE currentLight
    ATTRIBUTE timer

    CONSTRUCTOR()
        currentLight = TrafficLight.RED
        timer = 0
    END CONSTRUCTOR

    METHOD switchLight()
        IF currentLight == TrafficLight.RED AND timer >= 5 THEN
            currentLight = TrafficLight.GREEN
            timer = 0
        ELSE IF currentLight == TrafficLight.GREEN AND timer >= 4 THEN
            currentLight = TrafficLight.YELLOW
            timer = 0
        ELSE IF currentLight == TrafficLight.YELLOW AND timer >= 2 THEN
            currentLight = TrafficLight.RED
            timer = 0
        END IF
    END METHOD

    METHOD runSimulation()
        LOOP FOREVER
            PRINT "Current Light: ", currentLight
            WAIT 1 second
            timer = timer + 1
            switchLight()
        END LOOP
    END METHOD
END CLASS


MAIN
    traffic = NEW TrafficSignal()
    traffic.runSimulation()
END MAIN
