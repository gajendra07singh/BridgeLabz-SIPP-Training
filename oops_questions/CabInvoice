class Ride {
    double distance; // in kilometers
    int time; // in minutes

    public Ride(double distance, int time) {
        this.distance = distance;
        this.time = time;
    }
}

class InvoiceSummary {
    int totalRides;
    double totalFare;
    double averageFare;

    public InvoiceSummary(int totalRides, double totalFare) {
        this.totalRides = totalRides;
        this.totalFare = totalFare;
        this.averageFare = totalFare / totalRides;
    }

    public void printSummary() {
        System.out.println("Total Rides: " + totalRides);
        System.out.println("Total Fare: ₹" + totalFare);
        System.out.println("Average Fare per Ride: ₹" + averageFare);
    }
}

public class CabInvoiceGenerator {
    private static final double COST_PER_KM = 10;
    private static final int COST_PER_MINUTE = 1;
    private static final double MINIMUM_FARE = 5;

    public double calculateFare(double distance, int time) {
        double totalFare = distance * COST_PER_KM + time * COST_PER_MINUTE;
        return Math.max(totalFare, MINIMUM_FARE);
    }

    public InvoiceSummary calculateFare(Ride[] rides) {
        double totalFare = 0;
        for (Ride ride : rides) {
            totalFare += calculateFare(ride.distance, ride.time);
        }
        return new InvoiceSummary(rides.length, totalFare);
    }

    public static void main(String[] args) {
        CabInvoiceGenerator invoiceGenerator = new CabInvoiceGenerator();

        // Single ride example
        double fare = invoiceGenerator.calculateFare(2.0, 5);
        System.out.println("Fare for single ride: ₹" + fare);

        // Multiple rides example
        Ride[] rides = {
            new Ride(2.0, 5),
            new Ride(0.1, 1),
            new Ride(5.0, 10)
        };

        InvoiceSummary summary = invoiceGenerator.calculateFare(rides);
        summary.printSummary();
    }
}
